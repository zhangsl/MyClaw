{
  "name": "myclaw",
  "version": "0.1.0",
  "description": "Single-host Feishu multi-agent assistant powered by Pi SDK",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "start": "node dist/main.js",
    "dev": "node --import tsx src/main.ts",
    "demo": "node --import tsx src/main.ts --demo",
    "chat": "node --import tsx src/main.ts --console",
    "doctor": "node --import tsx src/main.ts --check",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "cron-parser": "5.10.2",
    "dotenv": "18.0.8",
    "proper-lockfile": "4.1.2",
    "typebox": "1.4.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.19.0"
  }
}
